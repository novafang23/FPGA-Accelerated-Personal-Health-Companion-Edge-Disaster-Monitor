# ============================================================
# SIH26181 Health Companion — .gitignore
# ============================================================

# ── Binary executables and simulation outputs ────────────────
*.exe
*.vvp
*.vcd
*.o
*.obj

# ── Vivado / AMD Xilinx EDA artifacts ────────────────────────
.Xil/
*.jou
*.log
*.str
*.pb
*.dmp
*.runs/
*.sim/
*.cache/
*.hw/
*.ip_user_files/
*.wcfg

# ── Renesas ForgeFPGA synthesis intermediates ────────────────
# Paths below are the current locations; the old FPGA-MED-DEVICE/... entries
# referenced a pre-restructuring layout that no longer exists.
# The whole ForgeFPGA build dir is ignored separately (see below); the
# curated evidence copies live in hardware/shrikefi/synthesis_evidence/.
hardware/shrikefi/forgefpga_project/ffpga/build/minplacer/
hardware/shrikefi/forgefpga_project/ffpga/build/ta_message/

# ── Curated, tracked synthesis evidence ──────────────────────
# These override the broad *.log / *.runs/ rules above: they are the small,
# hand-picked reports that back the numbers quoted in README.md.
!hardware/shrikefi/synthesis_evidence/
!hardware/shrikefi/synthesis_evidence/**
!hardware/zynq/synthesis_evidence/
!hardware/zynq/synthesis_evidence/**

# ── ESP-IDF build artifacts (firmware/shrikefi) ──────────────
firmware/shrikefi/build/
firmware/shrikefi/sdkconfig
firmware/shrikefi/sdkconfig.old
firmware/shrikefi/main/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── IDE and editor caches ────────────────────────────────────
.vscode/
.cache/
.clangd
compile_commands.json

# ── AI models (binary, use Git LFS if needed) ───────────────
*.dlc
*.onnx

# ── Archives ─────────────────────────────────────────────────
*.zip

# ── OS metadata ──────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Simulation binaries ─────────────────────────────────────
sim_ppg

# ── Agent instructions (internal) ────────────────────────────
AGENTS.md

# Additions to ignore project build artifacts
hardware/zynq/vivado_project/.Xil/
hardware/zynq/vivado_project/*.cache/
hardware/zynq/vivado_project/*.hw/
hardware/zynq/vivado_project/*.ip_user_files/
hardware/zynq/vivado_project/*.runs/
hardware/zynq/vivado_project/*.sim/
hardware/shrikefi/forgefpga_project/ffpga/build/
shrike_fpga/

# Generated HTML report intermediates
SIH26181_Hardware_Integration_CAD_Design_Report.html

# IDE and agent metadata
.agents/

# Environment and API keys
.env
.env.local

# Internal tools and extracted database archives
.serena/
mimic-iii-clinical-database-demo-1.4/
.history/

