  (rectangle (start 83.82 22.86) (end 254.00 147.32) (stroke (width 0.3) (type dash)) (fill (type none)) (uuid "62614566-85af-4309-8e8e-c6ff3374ee96"))
  (text "Vicharak ShrikeFi board" (at 86.82 28.86 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid "cc18fc59-ed04-443d-81d5-874accfd7917"))
  (text "Inside the dashed box: parts on the ShrikeFi PCB. Outside: external breakout modules." (at 86.82 33.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7391a1f0-4540-473f-97c3-91b3a669fbb7"))
  (text "SPI mode 0, 8-bit full duplex: MOSI carries the sample byte, MISO returns {beat, filt[6:0]}. Internal PCB traces." (at 86.82 86.36 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2449b8d2-c6a6-4002-ae13-3060639507e6"))
  (text "EN and PWR are internal traces: ESP32 drives both HIGH at boot to wake the FPGA (GPIO8 to EN, GPIO9 to PWR)." (at 86.82 91.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "298c40c2-d0d3-401a-b0fb-33dd31252ecd"))
  (text "VDDC and VDDIO: 3V3 from the onboard LDO, routed on the PCB (not wired externally)." (at 86.82 96.52 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b6a1940d-dc71-405d-b4a7-d1894b90607b"))
