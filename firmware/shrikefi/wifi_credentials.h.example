/*
 * wifi_credentials.h.example
 *
 * TEMPLATE. Copy this file to `wifi_credentials.h` (same directory) and fill in
 * your own network. The real `wifi_credentials.h` is listed in .gitignore and
 * must never be committed.
 *
 *     copy firmware\shrikefi\wifi_credentials.h.example firmware\shrikefi\wifi_credentials.h
 *     idf.py reconfigure
 *
 * The `idf.py reconfigure` is required: the build decides between the WiFi and
 * offline paths at configure time, so a plain `idf.py build` after creating this
 * file would keep using the previous mode. The build prints which mode it chose
 * ("ShrikeFi: WiFi + MQTT ENABLED ...") and the firmware logs it at boot.
 *
 * Alternatively, leave this file unused and set the credentials through
 * `idf.py menuconfig` -> "ShrikeFi configuration" -> WiFi SSID / Password,
 * which stores them in sdkconfig (also gitignored).
 *
 * If neither is set, the firmware skips WiFi/MQTT entirely and runs the
 * offline edge-monitor path. That is the recommended demo configuration.
 *
 * NOTE: the ESP32-S3 radio is 2.4 GHz ONLY. A 5 GHz-only SSID will never
 * associate, no matter how correct the password is.
 */
#pragma once

#define SHRIKEFI_WIFI_SSID "your-2.4ghz-ssid"
#define SHRIKEFI_WIFI_PASS "your-password"
