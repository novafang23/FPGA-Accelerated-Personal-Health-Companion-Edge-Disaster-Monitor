# ==============================================================================
# Renesas ForgeFPGA (SLG47910) Pin Constraints for Vicharak ShrikeFi Board
# SIH26181 Health Companion & Edge Disaster Monitor
# ==============================================================================

# Clock
set_io clk_en       OSC_EN      # Oscillator enable - resource, NOT a GPIO

# 4-Wire SPI Target Interface to ESP32-S3 (Internal PCB traces verified by schematic Sheet 5)
set_io spi_sck      PIN_16      # Connected to ESP32 GPIO 12 (F_SP_CLK)  -> GPIO3
set_io spi_ss_n     PIN_17      # Connected to ESP32 GPIO 10 (F_SPI_CS)  -> GPIO4
set_io spi_mosi     PIN_18      # Connected to ESP32 GPIO 11 (F_SPI_SI)  -> GPIO5
set_io spi_miso     PIN_19      # Connected to ESP32 GPIO 13 (F_SPI_SO)  -> GPIO6
set_io spi_miso_oe  PIN_19_OE   # Output enable for Pin 19 MISO pad (GPIO6_OE)

# Observable Hardware Output (Blue User LED D12 on Pin 7)
set_io led_user     PIN_7       # Blue User LED D12 -> GPIO16
set_io led_user_oe  PIN_7_OE    # Output enable for Pin 7 LED pad
